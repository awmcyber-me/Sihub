# Server-only database connections. Use separate pooled and direct URLs in production.
# Local development database; never put production credentials in this template.
DATABASE_URL="postgresql://sihub:replace-me@localhost:5432/sihub?schema=public"

# Direct connection used for migrations.
DIRECT_URL="postgresql://sihub:replace-me@localhost:5432/sihub?schema=public"

# Owner bootstrap is one-time: used only when no owner account exists.
BOOTSTRAP_OWNER_EMAIL="abdulkadirwaajib@gmail.com"
BOOTSTRAP_OWNER_PASSWORD="Dabuur6655443322110099@."
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
SESSION_TTL_HOURS="12"
COOKIE_SECURE="false"
TRUST_PROXY="false"

# Password reset configuration.
RESET_TOKEN_TTL_MINUTES="30"
RESET_BASE_URL="http://localhost:3000/reset-password"
EMAIL_PROVIDER="none"
EMAIL_FROM="noreply@sihub.local"
EMAIL_API_URL=""
EMAIL_API_KEY=""

# S3-compatible private media storage.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sihub-media"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_PUBLIC_BASE_URL="http://localhost:9000/sihub-media"

# Optional server-side AI integration. Never expose this to Vite client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
